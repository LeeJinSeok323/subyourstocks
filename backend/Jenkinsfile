pipeline {
    agent any

    environment {
        MYSQL_HOST       = 'host-gateway'
        MYSQL_PORT       = '3307'
        MYSQL_USER       = 'jinseoki'
        CLICKHOUSE_HOST  = 'clickhouse-server'
        CLICKHOUSE_PORT  = '8123'
        CLICKHOUSE_USER  = 'jinseoki'
        SERVER_PORT      = '8082'
        TZ               = 'Asia/Seoul'

        MYSQL_PASSWORD      = credentials('DB_PASSWORD')
        CLICKHOUSE_PASSWORD = credentials('clickhouse-password')
        JWT_SECRET          = credentials('JWT_SECRET')
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                git branch: 'main',
                    url: 'https://github.com/LeeJinSeok323/subyourstocks.git'
            }
        }

        stage('Build Image') {
            when { changeset "backend/**" }
            steps {
                sh 'docker build --no-cache -t stocker-backend:latest ./backend'
            }
        }

        stage('Deploy') {
            when { changeset "backend/**" }
            steps {
                sh '''
                    docker network create stocker-net 2>/dev/null || true
                    docker network connect stocker-net clickhouse-server 2>/dev/null || true

                    docker rm -f stocker-backend || true

                    docker run -d \
                        --name stocker-backend \
                        --network stocker-net \
                        --add-host=host-gateway:host-gateway \
                        --restart always \
                        -v /etc/localtime:/etc/localtime:ro \
                        -v /etc/timezone:/etc/timezone:ro \
                        -e TZ=${TZ} \
                        -e MYSQL_HOST=${MYSQL_HOST} \
                        -e MYSQL_PORT=${MYSQL_PORT} \
                        -e MYSQL_USER=${MYSQL_USER} \
                        -e MYSQL_PASSWORD=${MYSQL_PASSWORD} \
                        -e CLICKHOUSE_HOST=${CLICKHOUSE_HOST} \
                        -e CLICKHOUSE_PORT=${CLICKHOUSE_PORT} \
                        -e CLICKHOUSE_USER=${CLICKHOUSE_USER} \
                        -e CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD} \
                        -e SERVER_PORT=${SERVER_PORT} \
                        -e JWT_SECRET=${JWT_SECRET} \
                        -p 8082:8082 \
                        stocker-backend:latest
                '''
            }
        }
    }

    post {
        success { echo 'stocker-backend 배포 완료' }
        failure { echo 'stocker-backend 배포 실패' }
    }
}
